     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="168"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <CheckBox x:Name="RotationToggle" Style="{StaticResource RotationSwitch}" Checked="ToggleRotation" Unchecked="ToggleRotation" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="{local:Loc 'Mỗi'}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="IntervalBox" Visibility="Collapsed" TextChanged="RotationChanged"/><Button x:Name="IntervalPresetButton" Content="{local:Loc '10 phút  ⌄'}" Width="108" MinHeight="40" Click="OpenAppMenu" Margin="0" Padding="9" FontSize="12"><Button.ContextMenu><ContextMenu><MenuItem Header="{local:Loc '30 giây'}" Tag="30" Click="SetIntervalPreset"/><MenuItem Header="{local:Loc '1 phút'}" Tag="60" Click="SetIntervalPreset"/><MenuItem Header="{local:Loc '5 phút'}" Tag="300" Click="SetIntervalPreset"/><MenuItem Header="{local:Loc '10 phút'}" Tag="600" Click="SetIntervalPreset"/><MenuItem Header="{local:Loc '30 phút'}" Tag="1800" Click="SetIntervalPreset"/><MenuItem Header="{local:Loc '1 giờ'}" Tag="3600" Click="SetIntervalPreset"/><Separator/><MenuItem Header="{local:Loc 'Thời gian khác…'}" Click="CustomInterval"/></ContextMenu></Button.ContextMenu></Button></StackPanel>
      <ComboBox x:Name="ShuffleBox" Grid.Column="2" Margin="12,0,0,0" Width="137" FontSize="12" SelectionChanged="RotationSelectionChanged" VerticalAlignment="Center"><ComboBoxItem Content="{local:Loc 'Theo thứ tự'}" Tag="False"/><ComboBoxItem Content="{local:Loc 'Ngẫu nhiên'}" Tag="True"/></ComboBox>
      <ComboBox x:Name="MonitorBox" Grid.Column="3" DisplayMemberPath="Label" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
      <DockPanel Grid.Row="1" Grid.ColumnSpan="7" Margin="0,8,0,0">
       <TextBlock x:Name="RotationCollection" DockPanel.Dock="Right" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="230" Margin="10,0,0,0"/>
       <CheckBox x:Name="VideoEndBox" Content="{local:Loc 'Hết video thì đổi'}" FontSize="11" Margin="0" Checked="RotationChanged" Unchecked="RotationChanged"/>
      </DockPanel>
      <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,0,8,0"><Button x:Name="SaveRotationButton" Content="{local:Loc 'Lưu'}" Click="SaveSettings" Margin="0" Padding="10,6" MinHeight="29"/><TextBlock x:Name="RotationSaveState" Text="{local:Loc 'Đã lưu'}" FontSize="9" TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/></StackPanel>
      <Button x:Name="RotationButton" Grid.Column="6" Content="{local:Loc 'Bắt đầu luân phiên'}" Click="ApplyPlaylist" Margin="0" Padding="12,8" FontSize="12" VerticalAlignment="Center" MinWidth="129"/>
     </Grid>
    </Border>
    <Grid Grid.Row="4" Margin="8,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="NowPlaying" Text="{local:Loc 'Chưa phát wallpaper'}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PlaybackStatus" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="‹" Click="PreviousWallpaper" Style="{StaticResource Quiet}" Padding="10,3" ToolTip="{local:Loc 'Wallpaper desktop trước'}" AutomationProperties.Name="{local:Loc 'Wallpaper desktop trước'}"/><Button x:Name="PauseButton" Content="{local:Loc 'Tạm dừng'}" Click="PausePlayback" Style="{StaticResource Quiet}" FontSize="11"/><Button Content="›" Click="NextWallpaper" Style="{StaticResource Quiet}" Padding="10,3" ToolTip="{local:Loc 'Wallpaper desktop tiếp theo'}" AutomationProperties.Name="{local:Loc 'Wallpaper desktop tiếp theo'}"/><Button Content="{local:Loc 'Bỏ ghim'}" Click="UnpinWallpaper" Style="{StaticResource Quiet}" FontSize="11"/><Button Content="{local:Loc 'Dừng'}" Click="StopPlayback" Style="{StaticResource Quiet}" FontSize="11"/></StackPanel></Grid>
   </Grid>
  </Grid>

 </Grid></Border>
</Window>
